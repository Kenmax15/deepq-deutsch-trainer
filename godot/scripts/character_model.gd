class_name CharacterModel
extends Node3D
## Rigged, animated character: realistic MakeHuman people with
## motion-captured animations (assets/characters/*.glb, generated by
## tools/build_characters.sh). Stylised glTF models with Idle/Walk/Run/Wave
## clips (e.g. Quaternius) also work.
## Same interface as the procedural Humanoid (set_walk_speed, talk, wave), so
## NPC, player and dialogue code work with any of them.

@export var model_path := ""
@export var apron := false
@export var apron_color := Color(0.95, 0.94, 0.9)
## Standing NPCs can use the "Wait" clip (shifting weight, looking around).
@export var idle_clip := "Idle"

var walk_speed := 0.0
var _anim: AnimationPlayer
var _state := ""
var _talk_time := 0.0
var _wave_time := 0.0
var _skel: Skeleton3D
var _realistic := false
var _clip_speed := {"Walk": 1.2, "Run": 3.0}
## Head (and a little of the upper spine) turns towards this node when it is
## within `look_radius` metres and roughly in front.
var look_target: Node3D
var look_radius := 4.0
var _look_mods: Array = []
var _look_w := 0.0

const LOOPING := ["Idle", "Idle_Neutral", "Walk", "Run", "Talk", "Wait"]
const CLIPS_JSON := "res://assets/characters/clips.json"


func _ready() -> void:
	var scene: PackedScene = load(model_path)
	if scene == null:
		push_error("Character model not found: " + model_path)
		return
	var inst: Node3D = scene.instantiate()
	add_child(inst)
	_anim = inst.find_child("AnimationPlayer", true, false)
	_skel = inst.find_child("Skeleton3D", true, false)
	_realistic = _skel != null and _skel.find_bone("pelvis") >= 0
	if _realistic:
		_load_clip_speeds()
		_fix_materials(inst)
	if _anim:
		for n in LOOPING:
			if _anim.has_animation(n):
				_anim.get_animation(n).loop_mode = Animation.LOOP_LINEAR
		_anim.playback_default_blend_time = 0.35 if _realistic else 0.25
	if _skel and apron:
		_add_apron()
	if _realistic:
		_add_look_modifiers()
	_play(_idle())
	if _anim and _anim.is_playing():
		# desynchronise identical idles between characters
		_anim.seek(randf() * _anim.current_animation_length, true)


func _idle() -> String:
	return idle_clip if _anim and _anim.has_animation(idle_clip) else "Idle"


func _load_clip_speeds() -> void:
	## Native ground speed of the in-place walk/run cycles, measured when the
	## mocap was retargeted; used to scale playback so feet do not slide.
	var f := FileAccess.open(CLIPS_JSON, FileAccess.READ)
	if f == null:
		return
	var all = JSON.parse_string(f.get_as_text())
	var key := model_path.get_file().get_basename()
	if all is Dictionary and all.has(key):
		for c in ["Walk", "Run"]:
			if all[key].has(c):
				_clip_speed[c] = float(all[key][c]["speed"])


func _fix_materials(root: Node) -> void:
	## glTF from MakeHuman marks every material as alpha-blended. Make skin and
	## clothes opaque (correct shadows and sorting), give skin subsurface
	## scattering, and use alpha hashing for hair, brows and lashes.
	for mi in root.find_children("*", "MeshInstance3D", true, false):
		var m3 := mi as MeshInstance3D
		for s in range(m3.mesh.get_surface_count()):
			var src := m3.mesh.surface_get_material(s) as StandardMaterial3D
			if src == null:
				continue
			var m: StandardMaterial3D = src.duplicate()
			var n := (str(m3.name) + " " + str(src.resource_name)).to_lower()
			if "hair" in n or "short0" in n or "bob0" in n or "long0" in n or "ponytail" in n \
					or "braid" in n or "afro" in n or "eyebrow" in n or "eyelash" in n:
				m.transparency = BaseMaterial3D.TRANSPARENCY_ALPHA_HASH
				m.alpha_hash_scale = 1.0
				m.cull_mode = BaseMaterial3D.CULL_DISABLED
				m.roughness = 0.55
				m.specular_mode = BaseMaterial3D.SPECULAR_SCHLICK_GGX
			elif "body" in n:
				m.transparency = BaseMaterial3D.TRANSPARENCY_DISABLED
				m.roughness = 0.58
				m.metallic = 0.0
				m.subsurf_scatter_enabled = true
				m.subsurf_scatter_strength = 0.35
				m.subsurf_scatter_skin_mode = true
			elif "low-poly" in n or "eye" in n:
				m.transparency = BaseMaterial3D.TRANSPARENCY_DISABLED
				m.roughness = 0.12
			else:
				m.transparency = BaseMaterial3D.TRANSPARENCY_DISABLED
				m.roughness = max(m.roughness, 0.7)
				m.metallic = 0.0
			m3.set_surface_override_material(s, m)
		m3.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_ON


func _add_look_modifiers() -> void:
	if "--nolook" in OS.get_cmdline_user_args():
		return
	var m = preload("res://scripts/head_look.gd").new()
	_skel.add_child(m)
	_look_mods.append(m)
	if look_target:
		set_look_target(look_target)


func set_look_target(n: Node3D, radius := 4.0) -> void:
	look_target = n
	look_radius = radius
	for m in _look_mods:
		m.target = n


func _update_look(delta: float) -> void:
	if _look_mods.is_empty():
		return
	var want := false
	if look_target and is_instance_valid(look_target) and look_target.is_inside_tree():
		var to := look_target.global_position - global_position
		to.y = 0.0
		var fwd := global_transform.basis.z
		fwd.y = 0.0
		want = to.length() < look_radius and to.length() > 0.3 and fwd.normalized().dot(to.normalized()) > -0.1
	_look_w = move_toward(_look_w, 1.0 if want else 0.0, delta * 1.5)
	var w := smoothstep(0.0, 1.0, _look_w)
	for m in _look_mods:
		m.weight = w


func _add_apron() -> void:
	## A bakery apron following the upper spine (only used with stylised models).
	var bone := "spine_03" if _realistic else "Chest"
	if _skel.find_bone(bone) < 0:
		return
	var att := BoneAttachment3D.new()
	att.bone_name = bone
	_skel.add_child(att)
	var mi := MeshInstance3D.new()
	var bm := BoxMesh.new()
	bm.size = Vector3(0.36, 0.62, 0.02)
	mi.mesh = bm
	var m := StandardMaterial3D.new()
	m.albedo_color = apron_color
	m.roughness = 0.9
	mi.material_override = m
	mi.position = Vector3(0, -0.22, 0.13)
	att.add_child(mi)


func set_walk_speed(v: float) -> void:
	walk_speed = v


func talk(seconds: float) -> void:
	## Conversational gestures while speaking (no lip-sync yet).
	_talk_time = max(_talk_time, seconds)
	if _realistic:
		return
	if walk_speed < 0.15 and _anim and _anim.has_animation("Interact") and _wave_time <= 0.0:
		_wave_time = min(_anim.get_animation("Interact").length, 1.2)
		_play("Interact", true)


func wave(seconds := 1.6) -> void:
	if _anim == null or not _anim.has_animation("Wave"):
		return
	_wave_time = min(seconds, _anim.get_animation("Wave").length) if _realistic else seconds
	if _realistic:
		_wave_time = _anim.get_animation("Wave").length - 0.3
	_play("Wave", true)
	_anim.speed_scale = 1.0


func _play(name: String, force := false) -> void:
	if _anim == null or (_state == name and not force):
		return
	if not _anim.has_animation(name):
		return
	_state = name
	_anim.play(name)


func _process(delta: float) -> void:
	if _anim == null:
		return
	_update_look(delta)
	if _talk_time > 0.0:
		_talk_time -= delta
	if _wave_time > 0.0:
		_wave_time -= delta
		return
	if walk_speed > 2.4:
		_play("Run")
		_anim.speed_scale = clamp(walk_speed / _clip_speed["Run"], 0.6, 1.6)
	elif walk_speed > 0.15:
		_play("Walk")
		_anim.speed_scale = clamp(walk_speed / _clip_speed["Walk"], 0.5, 2.0)
	elif _talk_time > 0.0 and _realistic and _anim.has_animation("Talk"):
		_play("Talk")
		_anim.speed_scale = 1.0
	else:
		_play(_idle())
		_anim.speed_scale = 1.0
